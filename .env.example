# ==============================================================================
# ShikshaSetu AI (शिक्षासेतु) — Production & Cloud Environment Variables
# ==============================================================================

# Backend Cloud Hosting Configuration
PORT=8000
HOST=0.0.0.0

# CORS Configuration: comma-separated list of allowed origins
# (Defaults to development ports + https://pradeepchinige09.github.io if omitted)
CORS_ORIGINS=https://prompt-hackwar.onrender.com,https://pradeepchinige09.github.io,http://localhost:5173

# Frontend Production Configuration
# Set this to the public URL of your deployed FastAPI backend (e.g. on Render / Railway)
# If left empty in production, the application will default to the same-origin host
VITE_BACKEND_URL=https://your-backend-service.onrender.com

# Optional Unified Single-Service Deployment
# Set to 'true' if FastAPI should serve the built frontend 'dist' directory
SERVE_FRONTEND=false

# Optional Gemini Live Cloud Models
# ShikshaSetu runs 100% offline with built-in autonomous multi-agent simulation.
# If you wish to connect live cloud Gemini models, provide your key below:
# GEMINI_API_KEY=your_gemini_api_key_here
